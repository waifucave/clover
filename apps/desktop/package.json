  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@waifucave/clover-plugin-sdk": "workspace:*",
    "@waifucave/clover-protocol": "workspace:*",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}

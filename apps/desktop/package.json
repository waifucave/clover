  "private": true,
  "description": "Clover's desktop app (Electron).",
  "author": "waifucave",
  "license": "Apache-2.0",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "dist": "bun run scripts/build.ts && electron-builder --dir --publish never",

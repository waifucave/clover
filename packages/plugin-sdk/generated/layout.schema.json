        "title",
        "node"
      ],
      "additionalProperties": false
    },
    "__schema12": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "en": {
              "type": "string"
            }
          },
          "required": [
            "en"
          ],
          "additionalProperties": {
            "type": "string"
          }
        }
      ]
    },
    "__schema13": {
      "type": "string",
      "minLength": 2,
      "maxLength": 300,
      "pattern": "^[a-z][a-z0-9-]*(\\/[a-z][a-z0-9-]*)?(#[a-z0-9][a-z0-9._-]*)?$"
    },
    "__schema14": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "format": "path",
      "description": "A path relative to the plugin folder, with `/`; it must resolve inside it."
    }

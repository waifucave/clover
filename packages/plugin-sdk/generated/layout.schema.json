    },
    "__schema4": {
      "$ref": "#/$defs/__schema2"
    },
    "__schema5": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000
    },
    "__schema6": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000
    },
    "__schema7": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
    },
    "__schema8": {
      "$ref": "#/$defs/__schema2"
    },
    "__schema9": {
      "$ref": "#/$defs/__schema2"
    },
    "__schema10": {
      "type": "string",
      "enum": [
        "start",
        "center",
        "end",
        "stretch"
      ]

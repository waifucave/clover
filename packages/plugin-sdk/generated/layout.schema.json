    "__schema2": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        {
          "type": "string",
          "maxLength": 32,
          "pattern": "^(\\d+(\\.\\d+)?)(px|%|rem|em|vh|vw|fr)$"
        }
      ]
    },

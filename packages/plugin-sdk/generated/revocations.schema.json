{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clover revocation list",
  "description": "Revocations format 1, signed like an index (spec §5.1).",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 2048
    },
    "revocations": {
      "type": "number",
      "const": 1
    },
    "entries": {
      "maxItems": 100000,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    }
  },
  "required": [
    "revocations",
    "entries"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40,
          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
        },
        "versions": {
          "maxItems": 10000,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        "hashes": {
          "maxItems": 10000,
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "id",
        "reason"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "__schema2": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}

{
  "area": "host",
  "owner": "HS",
  "methods": {
    "host.ready": {
      "doc": "The background host is up (its hello said surface host) and says what it runs, from which app's copy.",
      "owner": "HS",
      "direction": "to-daemon",
      "roles": [
        "app"
      ],
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "release": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
          },
          "bundlePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "safeMode": {
            "type": "boolean"
          },
          "parts": {
            "type": "object",
            "properties": {
              "surfaces": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "background": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "tabs": {
                "maxItems": 1024,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            },
            "required": [
              "surfaces",
              "background",
              "tabs"
            ]
          }
        },
        "required": [
          "release",
          "bundlePath",
          "safeMode",
          "parts"
        ]
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    },
    "host.exiting": {
      "doc": "The host tells the engine before it exits on purpose, so its exit isn't counted as a crash.",
      "owner": "HS",
      "direction": "to-daemon",
      "roles": [
        "app"
      ],
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "update",
              "quit-everything",
              "safe-mode",
              "no-app"
            ]
          }
        },
        "required": [
          "reason"
        ]
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    },
    "host.menu": {
      "doc": "Open MOSS, open MOSS Code, or quit everything (the engine, the host and both apps), warning first when something is mid-work.",
      "owner": "HS",
      "direction": "to-daemon",
      "roles": [
        "app"
      ],
      "userOnly": true,
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "open-moss",
              "open-code",
              "quit-everything"
            ]
          },
          "confirmed": {
            "type": "boolean"
          }
        },
        "required": [
          "action"
        ]
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "done": {
                "type": "boolean",
                "const": true
              }
            },
            "required": [
              "done"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "done": {
                "type": "boolean",
                "const": false
              },
              "working": {
                "type": "object",
                "properties": {
                  "turns": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "agents": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "routines": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "turns",
                  "agents",
                  "routines"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "done",
              "working"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "host.adopt": {
      "doc": "A restarted engine adopts the running host it found by the host's lock, and hears what it runs.",
      "owner": "HS",
      "direction": "from-daemon",
      "roles": [
        "app"
      ],
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "engine": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
          }
        },
        "required": [
          "engine"
        ]
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "release": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
          },
          "safeMode": {
            "type": "boolean"
          },
          "parts": {
            "type": "object",
            "properties": {
              "surfaces": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "background": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "tabs": {
                "maxItems": 1024,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            },
            "required": [
              "surfaces",
              "background",
              "tabs"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "release",
          "safeMode",
          "parts"
        ],
        "additionalProperties": false
      }
    },
    "host.stop": {
      "doc": "The engine stops the host: before an update replaces its bundle or a newer engine comes in, or to quit everything.",
      "owner": "HS",
      "direction": "from-daemon",
      "roles": [
        "app"
      ],
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "update",
              "quit-everything",
              "safe-mode",
              "no-app"
            ]
          }
        },
        "required": [
          "reason"
        ]
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    },
    "host.safeMode": {
      "doc": "Safe mode for the host's UI parts only (§5.8): no third-party part is mounted; the engine's tools keep running.",
      "owner": "HS",
      "direction": "from-daemon",
      "roles": [
        "app"
      ],
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "on": {
            "type": "boolean"
          }
        },
        "required": [
          "on"
        ]
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    },
    "host.tab.input": {
      "doc": "The person's input to one of the host's tabs, forwarded from MOSS Code's browser panel.",
      "owner": "HS",
      "direction": "from-daemon",
      "roles": [
        "app"
      ],
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "events": {
            "minItems": 1,
            "maxItems": 256,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "mouse"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "down",
                        "up",
                        "move",
                        "enter",
                        "leave"
                      ]
                    },
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "button": {
                      "type": "string",
                      "enum": [
                        "left",
                        "middle",
                        "right"
                      ]
                    },
                    "clicks": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 3
                    },
                    "modifiers": {
                      "maxItems": 8,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "maxLength": 16
                      }
                    }
                  },
                  "required": [
                    "kind",
                    "type",
                    "x",
                    "y"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "wheel"
                    },
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "dx": {
                      "type": "number"
                    },
                    "dy": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "kind",
                    "x",
                    "y",
                    "dx",
                    "dy"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "key"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "down",
                        "up",
                        "char"
                      ]
                    },
                    "key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32
                    },
                    "code": {
                      "type": "string",
                      "maxLength": 32
                    },
                    "modifiers": {
                      "maxItems": 8,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "maxLength": 16
                      }
                    }
                  },
                  "required": [
                    "kind",
                    "type",
                    "key"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "ime"
                    },
                    "text": {
                      "type": "string",
                      "maxLength": 1024
                    }
                  },
                  "required": [
                    "kind",
                    "text"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "events"
        ]
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    },
    "host.front": {
      "doc": "Whether a MOSS or MOSS Code window is focused and visible now (the router's presence): the host's island hides its strip line then.",
      "owner": "HS",
      "direction": "from-daemon",
      "roles": [
        "app"
      ],
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {

            "type": "boolean"
          }
        },
        "required": [
          "front"
        ]
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    },
    "host.surfaces": {
      "doc": "The background host's surfaces on the screen now, for the product's own-windows list.",
      "owner": "HS",
      "direction": "to-daemon",
      "roles": [
        "app"
      ],
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "windows": {
            "maxItems": 64,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 128
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "width": {
                  "type": "number",
                  "minimum": 0
                },
                "height": {
                  "type": "number",
                  "minimum": 0
                },
                "display": {
                  "type": "string",
                  "maxLength": 128
                }
              },
              "required": [
                "id",
                "x",
                "y",
                "width",
                "height"
              ]
            }
          }
        },
        "required": [
          "windows"
        ],
        "additionalProperties": false
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    },
    "host.status": {
      "doc": "The background host's state now, as host_changed says it.",
      "owner": "HS",
      "direction": "to-daemon",
      "roles": [
        "app",
        "cli"
      ],
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "starting",
              "running",
              "safe-mode",
              "restarting",
              "stopped",
              "absent"
            ]
          },
          "crashes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "release": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
          },
          "bundlePath": {
            "type": "string",
            "maxLength": 4096
          },
          "since": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "gaveUp": {
            "type": "boolean"
          }
        },
        "required": [
          "state",
          "crashes",
          "since"
        ],
        "additionalProperties": false
      }
    },

{
  "area": "bots",
  "owner": "BT",
  "methods": {
    "bot.records": {
      "doc": "Every bot as engine data: its record, its main session and the size of its instructions.",
      "owner": "BT",
      "direction": "to-daemon",
      "roles": [
        "app",
        "cli",
        "remote",
        "layer"
      ],
      "capability": "bots.read",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {}
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "bots": {
            "maxItems": 1024,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 81,
                  "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\/[a-z][a-z0-9]*(-[a-z0-9]+)*)?$"
                },
                "name": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "en": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "en"
                      ],
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  ]
                },
                "model": {
                  "type": "string",
                  "maxLength": 200
                },
                "effort": {
                  "type": "string",
                  "maxLength": 32
                },
                "voice": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "provider": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "voice": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 256
                        },
                        "model": {
                          "type": "string",
                          "maxLength": 128
                        }
                      },
                      "required": [
                        "provider",
                        "voice"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "silent": {
                          "type": "boolean",
                          "const": true
                        }
                      },
                      "required": [
                        "silent"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "greeting": {
                  "type": "string",
                  "maxLength": 20000
                },
                "face": {
                  "type": "object",
                  "properties": {
                    "shape": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32
                    },
                    "color": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 32,
                          "pattern": "^[a-z-]+$"
                        },
                        {
                          "type": "string",
                          "pattern": "^#[0-9a-f]{6}$"
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                "madeBy": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "user"
                        }
                      },
                      "required": [
                        "kind"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "bot"
                        },
                        "id": {
                          "type": "string",
                          "maxLength": 81,
                          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\/[a-z][a-z0-9]*(-[a-z0-9]+)*)?$"
                        }
                      },
                      "required": [
                        "kind",
                        "id"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "move"
                        },
                        "plugin": {
                          "type": "string",
                          "maxLength": 81,
                          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\/[a-z][a-z0-9]*(-[a-z0-9]+)*)?$"
                        }
                      },
                      "required": [
                        "kind",
                        "plugin"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "default"
                        }
                      },
                      "required": [
                        "kind"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "createdAt": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "mainSession": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9._:-]+$"
                },
                "instructionsBytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "id",
                "name",
                "madeBy",
                "createdAt",
                "mainSession",
                "instructionsBytes"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "bots"
        ],
        "additionalProperties": false
      }
    },

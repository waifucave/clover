    "bot.remove": {
      "doc": "Removes a bot; what is kept of its folder, memory and conversation is an open point.",
      "owner": "BT",
      "direction": "to-daemon",
      "roles": [
        "app",
        "cli"
      ],
      "userOnly": true,
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 81,
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\/[a-z][a-z0-9]*(-[a-z0-9]+)*)?$"

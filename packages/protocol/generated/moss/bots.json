    "bot.edit": {
      "doc": "Changes a bot's record or instructions for the user; the next turn uses it.",
      "owner": "BT",
      "direction": "to-daemon",
      "roles": [
        "app",
        "cli"
      ],
      "userOnly": true,
      "change": "core",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 81,
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\/[a-z][a-z0-9]*(-[a-z0-9]+)*)?$"
          },
          "patch": {
            "type": "object",
            "properties": {
              "name": {

                    "type": "null"
                  }
                ]
              },
              "effort": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 32
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "voice": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "provider": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "voice": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 256
                          },
                          "model": {
                            "type": "string",
                            "maxLength": 128
                          }
                        },
                        "required": [
                          "provider",
                          "voice"
                        ]
                      },
                      {
                        "type": "object",
                        "properties": {
                          "silent": {
                            "type": "boolean",
                            "const": true
                          }
                        },
                        "required": [
                          "silent"
                        ]
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "greeting": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 20000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "face": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "shape": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 32
                      },
                      "color": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 32,
                            "pattern": "^[a-z-]+$"
                          },
                          {
                            "type": "string",
                            "pattern": "^#[0-9a-f]{6}$"
                          }
                        ]
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "required": [
          "id",
          "patch"
        ]
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "applied": {
                "type": "boolean",
                "const": true
              }
            },
            "required": [
              "applied"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",

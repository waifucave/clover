  "events": {
    "ui_settings_changed": {
      "doc": "The user's UI choices changed, here or on another device.",
      "owner": "E",
      "scope": "core",
      "roles": [
        "app"
      ],
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "ui_settings_changed"
          },
          "ts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "settings": {
            "type": "object",
            "properties": {
              "picks": {
                "maxItems": 10000,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "spot": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "key": {
                      "type": "string",
                      "maxLength": 256
                    },
                    "bot": {
                      "type": "string",
                      "maxLength": 81,
                      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\/[a-z][a-z0-9]*(-[a-z0-9]+)*)?$"
                    },
                    "entry": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 300,
                          "pattern": "^[a-z][a-z0-9/-]*(#[A-Za-z0-9._-]+)?$",
                          "minLength": 2
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "spot",
                    "entry"
                  ]
                }
              },
              "lists": {
                "maxItems": 1000,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "spot": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "bot": {
                      "type": "string",
                      "maxLength": 81,
                      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\/[a-z][a-z0-9]*(-[a-z0-9]+)*)?$"
                    },
                    "order": {
                      "maxItems": 1000,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "maxLength": 300,
                        "pattern": "^[a-z][a-z0-9/-]*(#[A-Za-z0-9._-]+)?$",
                        "minLength": 2
                      }
                    },
                    "hidden": {
                      "maxItems": 1000,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "maxLength": 300,
                        "pattern": "^[a-z][a-z0-9/-]*(#[A-Za-z0-9._-]+)?$",
                        "minLength": 2
                      }
                    }
                  },
                  "required": [
                    "spot",
                    "order",
                    "hidden"
                  ]
                }
              },
              "baseTheme": {
                "type": "string",
                "maxLength": 300,
                "pattern": "^[a-z][a-z0-9/-]*#[A-Za-z0-9._-]+$",
                "minLength": 3
              },
              "globalTheme": {
                "type": "string",
                "maxLength": 300,
                "pattern": "^[a-z][a-z0-9/-]*#[A-Za-z0-9._-]+$",
                "minLength": 3
              },
              "overrides": {
                "type": "object",
                "properties": {
                  "tokens": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 300
                        },
                        {
                          "type": "number"
                        }
                      ]
                    }
                  },
                  "css": {
                    "type": "string",
                    "maxLength": 200000
                  }
                }
              },
              "language": {
                "type": "string",
                "maxLength": 35
              },
              "appearance": {
                "type": "string",
                "enum": [
                  "light",
                  "dark",
                  "system"
                ]
              },
              "textSize": {
                "type": "string",
                "enum": [
                  "small",
                  "default",
                  "large"
                ]
              },
              "packs": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string",
                  "maxLength": 81,
                  "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\/[a-z][a-z0-9]*(-[a-z0-9]+)*)?$"
                }
              }
            },
            "required": [
              "picks",
              "lists"
            ]
          }
        },
        "required": [
          "type",
          "ts",
          "settings"
        ]
      }
    },
    "update_available": {
      "doc": "An update was found or is ready to install.",
      "owner": "M",
      "scope": "core",
      "roles": [
        "app",
        "cli"
      ],
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "update_available"
          },
          "ts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "version": {
            "type": "string",
            "maxLength": 64
          },
          "ready": {
            "type": "boolean"
          },
          "at": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "type",
          "ts",
          "version",
          "ready"
        ]
      }
    }
  }
}

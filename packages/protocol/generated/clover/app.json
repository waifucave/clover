                "items": {
                  "type": "object",
                  "properties": {
                    "spot": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "bot": {
                      "type": "string",
                      "maxLength": 81,
                      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\/[a-z][a-z0-9]*(-[a-z0-9]+)*)?$"
                    },
                    "order": {
                      "maxItems": 1000,
                      "type": "array",

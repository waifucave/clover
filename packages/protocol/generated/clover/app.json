          {
            "type": "object",
            "properties": {
              "applied": {
                "type": "boolean",
                "const": false
              },
              "card": {
                "type": "string",
                "pattern": "^card_[A-Za-z0-9_-]{6,64}$"
              }
            },
            "required": [

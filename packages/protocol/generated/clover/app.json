                      "items": {
                        "type": "string",
                        "maxLength": 300,
                        "pattern": "^[a-z][a-z0-9/-]*(#[A-Za-z0-9._-]+)?$",
                        "minLength": 2
                      }
                    }
                  },
                  "required": [
                    "spot",
                    "order",
                    "hidden"
                  ]
                }
              },
              "baseTheme": {
                "type": "string",
                "maxLength": 300,
                "pattern": "^[a-z][a-z0-9/-]*#[A-Za-z0-9._-]+$",
                "minLength": 3
              },
              "globalTheme": {
                "type": "string",
                "maxLength": 300,
                "pattern": "^[a-z][a-z0-9/-]*#[A-Za-z0-9._-]+$",
                "minLength": 3
              },
              "overrides": {
                "type": "object",
                "properties": {
                  "tokens": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "type": "string",
                          "maxLength": 300
                        },
                        {
                          "type": "number"
                        }
                      ]
                    }
                  },
                  "css": {
                    "type": "string",
                    "maxLength": 200000
                  }
                }
              },
              "language": {
                "type": "string",
                "maxLength": 35
              },
              "appearance": {
                "type": "string",
                "enum": [
                  "light",
                  "dark",
                  "system"
                ]
              },
              "textSize": {
                "type": "string",
                "enum": [
                  "small",
                  "default",
                  "large"
                ]
              },
              "packs": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string",
                  "maxLength": 81,
                  "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\/[a-z][a-z0-9]*(-[a-z0-9]+)*)?$"

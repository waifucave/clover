{
  "area": "app",
  "owner": "E (with C, D, G, M)",
  "methods": {
    "pair.status": {
      "doc": "What would stop if this computer quit, for Quit's question (§3.1).",
      "owner": "C",
      "direction": "to-daemon",
      "roles": [
        "app",
        "cli"
      ],
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {}
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "bots": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 81,
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\/[a-z][a-z0-9]*(-[a-z0-9]+)*)?$"
            }
          },
          "routines": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "agents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "canHandOver": {
            "type": "boolean"
          },
          "safeMode": {
            "type": "boolean"
          },
          "updateReady": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": [
          "bots",
          "routines",
          "agents",
          "canHandOver",
          "safeMode"
        ],
        "additionalProperties": false
      }
    },
    "pair.quit": {
      "doc": "Quits the app and the daemon; with `handOver`, releases the lease first so another computer takes the bots.",
      "owner": "C",
      "direction": "to-daemon",
      "roles": [
        "app",
        "cli"
      ],
      "userOnly": true,
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "handOver": {
            "type": "boolean"
          }
        },
        "required": [
          "handOver"
        ]
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    },
    "pair.exiting": {
      "doc": "The app says it is leaving on purpose, so the daemon doesn't restart it (§3.1).",
      "owner": "C",
      "direction": "to-daemon",
      "roles": [
        "app"
      ],
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "quit",
              "update",
              "restart"
            ]
          }
        },
        "required": [
          "reason"
        ]
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    },
    "app.show": {
      "doc": "The daemon asks the app to open a window or a place in it (a sign-in page, a card from the CLI's `clover open`).",
      "owner": "E",
      "direction": "from-daemon",
      "roles": [
        "app"
      ],
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "what": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "window"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "bot"
                  },
                  "bot": {
                    "type": "string",
                    "maxLength": 81,
                    "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\/[a-z][a-z0-9]*(-[a-z0-9]+)*)?$"
                  }
                },
                "required": [
                  "kind",
                  "bot"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "session"
                  },
                  "session": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9._:-]+$"
                  }
                },
                "required": [
                  "kind",
                  "session"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "card"
                  },
                  "card": {
                    "type": "string",
                    "pattern": "^card_[A-Za-z0-9_-]{6,64}$"
                  }
                },
                "required": [
                  "kind",
                  "card"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "settings"
                  },
                  "section": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "item": {
                    "type": "string",
                    "maxLength": 256
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "url"
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "kind",
                  "url"
                ]
              }
            ]
          }
        },
        "required": [
          "what"
        ]
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    },
    "app.ping": {
      "doc": "The pair's heartbeat (ruling R9): the app answers at once from its main process; a daemon that hears nothing for a while restarts it in safe mode (lane C).",
      "owner": "E",
      "direction": "from-daemon",
      "roles": [
        "app"
      ],
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {}
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    },
    "app.quit": {
      "doc": "The daemon tells the app it is stopping the pair (a Quit from the CLI, an update).",
      "owner": "E",
      "direction": "from-daemon",
      "roles": [
        "app"
      ],
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "enum": [
              "quit",
              "update"
            ]
          }
        },
        "required": [
          "reason"
        ]
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    },
    "layer.token": {
      "doc": "A token for one plugin layer's connection (role `layer`), which the app's main process opens for it.",
      "owner": "C",
      "direction": "to-daemon",
      "roles": [
        "app"
      ],
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "pluginId": {
            "type": "string",
            "maxLength": 81,
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\/[a-z][a-z0-9]*(-[a-z0-9]+)*)?$"
          }
        },
        "required": [
          "pluginId"
        ]
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "token"
        ],
        "additionalProperties": false
      }
    },
    "ui.settings": {
      "doc": "The user's UI choices, which the app's plugin runtime applies.",
      "owner": "E",
      "direction": "to-daemon",
      "roles": [
        "app"
      ],
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {}
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "picks": {
            "maxItems": 10000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "spot": {
                  "type": "string",
                  "maxLength": 128
                },
                "key": {
                  "type": "string",
                  "maxLength": 256
                },
                "bot": {
                  "type": "string",
                  "maxLength": 81,
                  "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\/[a-z][a-z0-9]*(-[a-z0-9]+)*)?$"
                },
                "entry": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 300,
                      "pattern": "^[a-z][a-z0-9/-]*(#[A-Za-z0-9._-]+)?$",
                      "minLength": 2
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "spot",
                "entry"
              ],
              "additionalProperties": false
            }
          },
          "lists": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "spot": {
                  "type": "string",
                  "maxLength": 128
                },
                "bot": {
                  "type": "string",
                  "maxLength": 81,
                  "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\/[a-z][a-z0-9]*(-[a-z0-9]+)*)?$"
                },
                "order": {
                  "maxItems": 1000,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 300,
                    "pattern": "^[a-z][a-z0-9/-]*(#[A-Za-z0-9._-]+)?$",
                    "minLength": 2
                  }
                },
                "hidden": {
                  "maxItems": 1000,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 300,
                    "pattern": "^[a-z][a-z0-9/-]*(#[A-Za-z0-9._-]+)?$",
                    "minLength": 2
                  }
                }
              },
              "required": [
                "spot",
                "order",
                "hidden"
              ],
              "additionalProperties": false
            }
          },
          "baseTheme": {
            "type": "string",
            "maxLength": 300,
            "pattern": "^[a-z][a-z0-9/-]*#[A-Za-z0-9._-]+$",
            "minLength": 3
          },
          "globalTheme": {
            "type": "string",
            "maxLength": 300,
            "pattern": "^[a-z][a-z0-9/-]*#[A-Za-z0-9._-]+$",
            "minLength": 3
          },
          "overrides": {
            "type": "object",
            "properties": {
              "tokens": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 300
                    },
                    {
                      "type": "number"
                    }
                  ]
                }
              },
              "css": {
                "type": "string",
                "maxLength": 200000
              }
            },
            "additionalProperties": false
          },
          "language": {
            "type": "string",
            "maxLength": 35
          },
          "appearance": {
            "type": "string",
            "enum": [
              "light",
              "dark",
              "system"
            ]
          },
          "textSize": {
            "type": "string",
            "enum": [
              "small",
              "default",
              "large"
            ]
          },
          "packs": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 81,
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\/[a-z][a-z0-9]*(-[a-z0-9]+)*)?$"
            }
          }
        },
        "required": [
          "picks",
          "lists"
        ],
        "additionalProperties": false
      }
    },
    "ui.set": {

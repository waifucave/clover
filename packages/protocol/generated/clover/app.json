      "roles": [
        "app",
        "layer"
      ],
      "userOnly": true,
      "change": "core",
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "patch": {
            "type": "object",
            "properties": {
              "picks": {
                "maxItems": 10000,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "spot": {
                      "type": "string",
                      "maxLength": 128
                    },
                    "key": {
                      "type": "string",
                      "maxLength": 256
                    },

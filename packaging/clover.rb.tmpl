# Homebrew cask template for Clover. Rendered per release by scripts/release.ts
# (caskFrom in scripts/release-lib.ts) into out/release/<version>/clover.rb — this .tmpl is
# the only copy committed to the repo; the rendered file is per-release build output.
#
# Interpolated at release time: the release version and the sha256 checksum of the release DMG.
# The download URL is derived from the version at cask-eval time via Ruby's #{version}
# interpolation (idiomatic cask style — keeps a real per-version sha256, passes brew audit).
# (Slot names written in prose, not the literal syntax, so caskFrom's replaceAll can't mangle
# this comment itself.)
cask "clover" do
  version "{{version}}"
  sha256 "{{sha256}}"

  url "https://github.com/waifucave/clover/releases/download/v#{version}/Clover-#{version}.dmg"
  name "Clover"
  desc "Bot-first, endlessly moddable desktop agent platform"
  homepage "https://github.com/waifucave/clover"

  livecheck do
    url :url
    strategy :github_latest
  end

  depends_on arch: :arm64

  # electron-updater updates the app and the daemon together (spec §3.1).
  auto_updates true

  app "Clover.app"
  binary "#{appdir}/Clover.app/Contents/Resources/daemon/clover-core", target: "clover"

  # Login start is the daemon's (lane C: a launchd agent running clover-core supervise). The app turns it on at its
  # first launch; uninstalling removes it through the daemon's own command, as the user, before the app's files go
  # (packaging/installer-hooks.ts): `autostart remove` stops the daemon and deletes its agent. Homebrew runs these in
  # its own order: launchctl, then quit, then the script. The script runs through /bin/sh and exits 0 when the app's
  # binary is gone (the app dragged to the Trash first), since Homebrew refuses a missing executable before
  # must_succeed counts; then the launchctl stanza has already removed the agent, Clover's own label only, and
  # must_succeed: false keeps a failing command from stopping the uninstall.
  uninstall launchctl: "com.waifucave.clover.core",
            quit:      "com.waifucave.clover",
            script:    {
              executable:   "/bin/sh",
              args:         ["-c", '[ -x "$1" ] || exit 0; exec "$1" autostart remove', "sh", "#{appdir}/Clover.app/Contents/Resources/daemon/clover-core"],
              sudo:         false,
              must_succeed: false,
            }

  # ~/.clover is not here: it holds the user's bots, their history and their keys.
  zap trash: [
    "~/Library/Application Support/Clover",
    "~/Library/Caches/@waifucaveclover-desktop-updater",
    "~/Library/Caches/com.waifucave.clover",
    "~/Library/Caches/com.waifucave.clover.ShipIt",
    "~/Library/HTTPStorages/com.waifucave.clover",
    "~/Library/LaunchAgents/com.waifucave.clover.core.plist",
    "~/Library/Logs/Clover",
    "~/Library/Preferences/com.waifucave.clover.plist",
    "~/Library/Saved Application State/com.waifucave.clover.savedState",
  ]
end

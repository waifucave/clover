# Homebrew cask template for MOSS Code. Rendered per release by scripts/release.ts
# (caskFrom in scripts/release-lib.ts) into out/release/<version>/moss-code.rb — this .tmpl is
# the only copy committed to the repo; the rendered file is per-release build output.
#
# Interpolated at release time: the release version and the sha256 checksum of the release DMG.
# The download URL is derived from the version at cask-eval time via Ruby's #{version}
# interpolation (idiomatic cask style — keeps a real per-version sha256, passes brew audit).
# (Slot names written in prose, not the literal syntax, so caskFrom's replaceAll can't mangle
# this comment itself.)
cask "moss-code" do
  version "{{version}}"
  sha256 "{{sha256}}"

  url "https://github.com/waifucave/moss/releases/download/v#{version}/MOSS-Code-#{version}.dmg"
  name "MOSS Code"
  desc "Bot-first, endlessly moddable desktop agent platform"
  homepage "https://github.com/waifucave/moss"

  livecheck do
    url :url
    strategy :github_latest
  end

  depends_on arch: :arm64

  # electron-updater updates the app and the daemon together (spec §3.1).
  auto_updates true

  app "MOSS Code.app"
  binary "#{appdir}/MOSS Code.app/Contents/Resources/daemon/moss-core", target: "moss"

  # Login start is the daemon's (lane C: a launchd agent running moss-core supervise). The app turns it on at its
  # first launch; uninstalling removes it through the daemon's own command, as the user, before the app's files go
  # (packaging/installer-hooks.ts): `autostart remove` stops the daemon and deletes its agent. Homebrew runs these in
  # its own order: launchctl, then quit, then the script. The script runs through /bin/sh and exits 0 when the app's
  # binary is gone (the app dragged to the Trash first), since Homebrew refuses a missing executable before
  # must_succeed counts; then the launchctl stanza has already removed the agent, MOSS's own label only, and
  # must_succeed: false keeps a failing command from stopping the uninstall.
  uninstall launchctl: "com.waifucave.moss.core",
            quit:      "com.waifucave.moss.code",
            script:    {
              executable:   "/bin/sh",
              args:         ["-c", '[ -x "$1" ] || exit 0; exec "$1" autostart remove', "sh", "#{appdir}/MOSS Code.app/Contents/Resources/daemon/moss-core"],
              sudo:         false,
              must_succeed: false,
            }

  # The owner's rule: zap removes the caches, the preferences, the logs and the login item, and nothing else. ~/.moss
  # (the user's bots, their history and their keys) and the app's own data stay.
  zap trash: [
    "~/Library/Caches/@waifucavemoss-desktop-updater",
    "~/Library/Caches/com.waifucave.moss.code",
    "~/Library/Caches/com.waifucave.moss.code.ShipIt",
    "~/Library/LaunchAgents/com.waifucave.moss.core.plist",
    "~/Library/Logs/MOSS Code",
    "~/Library/Preferences/com.waifucave.moss.code.plist",
  ]
end

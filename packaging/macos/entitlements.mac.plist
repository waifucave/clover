<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app's entitlements under the hardened runtime (apps/desktop/electron-builder.yml), for the app and its Electron
     helpers alike: V8's JIT needs allow-jit, and Electron's renderers allow-unsigned-executable-memory. Library
     validation stays on: everything the app loads is signed by the same team. The daemon and the link sidecar in
     Contents/Resources/daemon/ are signed with their own (scripts/release/lib.ts, RESOURCE_BINARIES). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>

{
  "name": "clover-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:workspaces": "bun scripts/workspaces.ts run test",
    "protocol:generate": "pnpm --filter @waifucave/clover-protocol generate",
    "version:sync": "bun run scripts/sync-version.ts",
    "version:bump": "bun run scripts/bump-version.ts",
    "version:bump:feature": "bun run scripts/bump-version.ts --feature",
    "version:bump:major": "bun run scripts/bump-version.ts --major",
    "tap:publish": "bun run scripts/publish-tap.ts",
    "build:winter": "bun run scripts/build-winter.ts",
    "build:daemon": "bun run scripts/build-daemon.ts",
    "build:app": "cd apps/desktop && bun run dist",
    "runtimes:stage": "bun run scripts/stage-runtimes.ts",
    "verify:workflow": "bun run scripts/verify-workflow-compiled.ts",
    "verify:automation-worker": "bun run scripts/verify-automation-worker-compiled.ts",
    "check:idle-wakeups": "bun run scripts/check-idle-wakeups.ts",
    "e2e:cu-live": "bun run scripts/cu-live/run.ts",
    "build:page-runtime": "bun run scripts/build-page-runtime.ts",
    "e2e:browser": "bun run scripts/browser-e2e/run.ts",
    "verify:runtime-state": "bun run scripts/verify-runtime-state-compiled.ts",
    "verify:runtimes": "bun run scripts/verify-runtimes-compiled.ts",
    "verify:embedded": "bun run scripts/verify-embedded-compiled.ts",
    "verify:computer-helper": "bun run scripts/verify-computer-helper.ts",
    "verify:headless-helper": "bun run scripts/verify-headless-helper.ts",
    "verify:cowork-native": "bun run scripts/verify-cowork-native.ts",
    "verify:fd-receiver": "bun run scripts/verify-fd-receiver-compiled.ts",
    "verify:sealed-core": "bun run scripts/verify-sealed-core.ts",
    "verify:sealed-core:proof": "bun run scripts/verify-sealed-core.ts --require-proof",
    "verify:cowork-vm": "bun run spikes/cowork-vm/run.ts",
    "typecheck:core": "tsc --noEmit -p packages/core",
    "typecheck:page-runtime": "tsc --noEmit -p packages/core/src/computer-use/browser/page-runtime",
    "typecheck:protocol": "tsc --noEmit -p packages/protocol",
    "typecheck:cli": "tsc --noEmit -p packages/cli",
    "typecheck:plugin-sdk": "tsc --noEmit -p packages/plugin-sdk",
    "typecheck:scripts": "tsc --noEmit -p scripts",
    "typecheck": "bun run typecheck:page-runtime && bun run typecheck:scripts && bun scripts/workspaces.ts run typecheck",
    "verify:office-agent": "bun run scripts/office-agent-gate.ts",
    "dev:daemon": "bun run scripts/dev-daemon.ts",
    "dev:app": "bun run scripts/dev-app.ts",
    "dev:helper": "bun run scripts/dev-helper.ts",
    "dev:cowork-native": "bun run scripts/dev-cowork-native.ts",
    "dev:headless": "bun run scripts/dev-headless.ts",
    "icons:render": "bun run scripts/render-icons.ts",
    "cef:fetch": "bun run scripts/fetch-cef.ts",
    "monaco:fetch": "bun run scripts/fetch-monaco.ts",
    "libreoffice:fetch": "bun run scripts/fetch-libreoffice.ts"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "1.4.4",
    "openpgp": "6.3.2",
    "typescript": "^5.6.0",
    "wrangler": "4.153.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "plugins/*",
    "plugins/*/*",
    "plugins/*/plugins/*",
    "plugins/*/plugins/*/gallery",
    "services/*",
    "native/*",
    "spikes/*",
    "examples/*"
  ],
  "pnpm": {
    "overrides": {
      "shell-quote": ">=1.11.0",
      "fast-uri": ">=3.1.9 <4",
      "@types/node": "25.9.3",
      "sharp": "0.35.5",
      "undici": "7.30.1",
      "minimatch@>=7 <11.0.1": "11.0.1"
    }
  },
  "overrides": {
    "shell-quote": ">=1.11.0",
    "fast-uri": ">=3.1.9 <4",
    "@types/node": "25.9.3",
    "sharp": "0.35.5",
    "undici": "7.30.1",
    "minimatch@>=7 <11.0.1": "11.0.1"
  }
}

{
  "name": "clover-spike-s7-browser",
  "private": true,
  "type": "module",
  "description": "Spike S7 (the Clover Browser): hidden and shown tabs, throttling, screenshots, Wayland, Chrome for Testing, the app and daemon pair, the streamed view. Not a workspace member.",
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p src/pages",
    "test": "bun test test",
    "build": "bun run scripts/build.ts",
    "electron:install": "node node_modules/electron/install.js",
    "probe": "bun run scripts/probe.ts",
    "cft": "bun run src/cft/run.ts",
    "pair": "bun run src/pair/run.ts",
    "summarize": "bun run src/summarize.ts"
  },
  "dependencies": {
    "jpeg-js": "0.4.4",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/ws": "8.18.2",
    "electron": "45.2.2",
    "typescript": "5.9.3"
  }
}

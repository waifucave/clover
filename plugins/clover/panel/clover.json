{
  "manifest": 1,
  "name": "Panel",
  "description": "The right-hand panel: its toggles, the views it holds two at a time, and the session view.",
  "engines": {
    "clover": "^1.0.0"
  },
  "client": {
    "entry": "client/index.tsx",
    "css": [
      "client/styles.css"
    ]
  },
  "capabilities": [
    "computers.read"
  ],
  "contributes": {
    "ui": [
      {
        "spot": "panel",
        "key": "session",
        "title": "Session",
        "component": "SessionView"
      }
    ]
  }
}

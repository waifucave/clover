{
  "notes": "Codex, through `@agentclientprotocol/codex-acp` 2.5.0, which drives the user's own `codex app-server`  (`CODEX_PATH`); its fence is `CODEX_CONFIG`, and `NO_BROWSER` keeps its sign-in from opening a browser. Unmeasured (from docs, `--help` and code, S5 §3): where a row isn't known it takes the cautious value (a reattach by `load` with its replay dropped, MCP names unread, calls a cancel leaves open closed by Clover), it is held as acting without asking (`unasked-actions`) since it loads the user's own approval settings, and no sandbox is admitted, so it asks for the user's OK. The agent suite's live gates measure each row.",
  "source": "docs and code (S5 §3)",
  "readOnlyMode": {
    "option": "mode",
    "values": [
      "read-only"
    ]
  },
  "quirks": {
    "capabilities": {
      "snakeCaseDuplicates": false,
      "httpMcpUnadvertised": false
    },
    "turns": {
      "refusal": "unknown",
      "cancelLeavesToolCallsOpen": true,
      "reportsUsage": true,
      "quotaErrorsAsText": false
    },
    "progress": {
      "countsChildProcesses": true
    },
    "placement": "local",
    "marks": [
      "unasked-actions"
    ],
    "launch": {
      "identity": {
        "versionArgs": [
          "--version"
        ],
        "versionPattern": "^(?:codex-acp\\s+)?v?(\\d+\\.\\d+\\.\\d+)\\s*$"
      },
      "envAllow": [
        "CODEX_PATH",
        "CODEX_HOME"
      ],
      "envSet": {
        "NO_BROWSER": "1"
      },
      "versions": ">=2.5.0 <3.0.0"
    },
    "mcp": {
      "transports": [
        "stdio",
        "http"
      ],
      "storesPlainText": false,
      "passesEnvironment": false,
      "instructionsReachPrompt": "unknown",
      "systemPromptChannel": null,
      "tellsConversationId": false
    },
    "sessions": {
      "load": {
        "supported": true,
        "replays": true
      },
      "resume": {
        "supported": false,
        "replays": false
      },
      "replayKeepsToolCallIds": true,
      "listFiltersHonestly": false,
      "close": false
    },
    "permissions": {
      "optionKinds": [
        "allow_once",
        "allow_always",
        "reject_once"
      ],
      "neverAsks": [],
      "mcpNames": null
    },
    "config": {
      "modelOption": "model",
      "effortOption": "thought_level",
      "effortInModel": false,
      "choicePersists": false
    },
    "auth": {
      "methods": [],
      "requiredError": {
        "code": -32000
      }
    }
  }
}

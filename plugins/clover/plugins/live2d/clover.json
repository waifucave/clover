{
  "manifest": 1,
  "name": "2D model avatar",
  "description": "Draws a bot's 2D model on its stage, breathing and blinking, its mouth moving with the bot's voice as the app describes it. It hears nothing itself and plays no sound.",
  "engines": {
    "clover": "^1.0.0"
  },
  "client": {
    "entry": "client/index.tsx"
  },
  "contributes": {
    "locales": [
      {
        "lang": "en",
        "file": "locales/en.json"
      }
    ],
    "ui": [
      {
        "spot": "avatar",
        "id": "live2d",
        "key": "live2d",
        "component": "Live2dAvatarEntry"
      }
    ],
    "avatar.formats": [
      {
        "id": "live2d",
        "format": "live2d",
        "name": "Live2D (Cubism)",
        "entry": {
          "extensions": [
            ".model3.json",
            ".zip"
          ]
        },
        "files": {
          "kinds": [
            {
              "ext": [
                ".json"
              ],
              "type": "json",
              "maxBytes": 8388608
            },
            {
              "ext": [
                ".moc3"
              ],
              "type": "binary",
              "maxBytes": 134217728
            },
            {
              "ext": [
                ".png",
                ".webp",
                ".jpg",
                ".jpeg"
              ],
              "type": "image",
              "maxBytes": 33554432
            }
          ],
          "find": "cubism-model3",
          "maxFiles": 512
        },
        "import": {
          "accepts": [
            "folder",
            "zip"
          ]
        },
        "capabilities": [
          "lipsync",
          "expressions",
          "motions",
          "outfits",
          "pace"
        ]
      }
    ]
  }
}

{
  "manifest": 1,
  "name": "Sidebar",
  "description": "The default sidebar: the bots and their live agents, or the coding sessions by project, with the account and settings at the bottom.",
  "engines": {
    "clover": "^1.0.0"
  },
  "client": {
    "entry": "client/index.tsx",
    "css": [
      "client/styles.css"
    ]
  },
  "capabilities": [
    "bots.read",
    "computers.read"
  ],
  "contributes": {
    "ui": [
      {
        "spot": "sidebar",
        "component": "Sidebar",
        "declares": {
          "sidebar.bot": {
            "shape": "keyed",
            "props": {}
          },
          "sidebar.app": {
            "shape": "list",
            "props": {}
          }
        }
      }
    ]
  }
}

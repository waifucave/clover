{
  "manifest": 1,
  "name": "Settings",
  "description": "The settings window, with Clover's own sections (account, devices, appearance, notifications, plugins, levels, bots), and the language chooser.",
  "engines": {
    "clover": "^1.0.0"
  },
  "client": {
    "entry": "client/index.tsx",
    "css": [
      "client/styles.css"
    ]
  },
  "capabilities": [
    "bots.read",
    "computers.read",
    "devices.read"
  ],
  "contributes": {
    "locales": [
      {
        "lang": "en",
        "file": "locales/en.json"
      }
    ],
    "ui": [
      {
        "spot": "main",
        "key": "settings",
        "component": "SettingsEntry",
        "declares": {
          "settings.section": {
            "shape": "list",
            "props": {},
            "fields": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "icon": {
                  "type": "string"
                }
              }
            },
            "doc": "Sections plugins add after Clover's own; each entry draws its page."
          }
        }
      }
    ]
  }
}

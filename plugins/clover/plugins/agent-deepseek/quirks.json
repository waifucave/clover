{
  "notes": "DeepSeek Harness (`dsh --profile acp`), with `@deepseek-ai/dsh-acp` 0.1.2 or later: earlier builds, npm's `latest`  among them, refuse every MCP server, so the bridge can't reach them. One workspace; an honest `resume`, no `load`. Unmeasured (from docs, `--help` and code, S5 §3): where a row isn't known it takes the cautious value (a reattach by `load` with its replay dropped, MCP names unread, calls a cancel leaves open closed by Clover), it is held as acting without asking (`unasked-actions`) since it loads the user's own approval settings, and no sandbox is admitted, so it asks for the user's OK. The agent suite's live gates measure each row.",
  "source": "docs and code (S5 §3)",
  "quirks": {
    "capabilities": {
      "snakeCaseDuplicates": false,
      "httpMcpUnadvertised": false
    },
    "turns": {
      "refusal": "unknown",
      "cancelLeavesToolCallsOpen": true,
      "reportsUsage": true,
      "quotaErrorsAsText": false
    },
    "progress": {
      "countsChildProcesses": true
    },
    "placement": "local",
    "marks": [
      "unasked-actions"
    ],
    "launch": {
      "identity": {
        "versionArgs": [
          "--version"
        ],
        "versionPattern": "(\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.]+)?)"
      },
      "envAllow": [
        "DEEPSEEK_API_KEY"
      ],
      "envSet": {},
      "versions": ">=0.1.2 <1.0.0"
    },
    "mcp": {
      "transports": [
        "stdio",
        "http"
      ],
      "storesPlainText": false,
      "passesEnvironment": false,
      "instructionsReachPrompt": "unknown",
      "systemPromptChannel": null,
      "tellsConversationId": false
    },
    "sessions": {
      "load": {
        "supported": false,
        "replays": false
      },
      "resume": {
        "supported": true,
        "replays": false
      },
      "replayKeepsToolCallIds": true,
      "listFiltersHonestly": false,
      "close": true
    },
    "permissions": {
      "optionKinds": [
        "allow_once",
        "reject_once"
      ],
      "neverAsks": [],
      "mcpNames": null
    },
    "config": {
      "modelOption": "model",
      "effortOption": null,
      "effortInModel": false,
      "choicePersists": false
    },
    "auth": {
      "methods": [],
      "requiredError": {
        "code": -32000
      }
    }
  }
}

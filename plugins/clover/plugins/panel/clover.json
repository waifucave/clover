{
  "manifest": 1,
  "name": "Panel",
  "description": "The column beside the conversation: a coding session's (its agents, where it runs, context, connectors, outputs and changes) and a bot's slim one (its agents and tasks, context and outputs).",
  "engines": {
    "clover": "^1.0.0"
  },
  "client": {
    "entry": "client/index.tsx",
    "css": [
      "client/styles.css"
    ]
  },
  "capabilities": [
    "conversation.read",
    "computers.read"
  ],
  "contributes": {
    "ui": [
      {
        "spot": "panel",
        "id": "session-column",
        "key": "session",
        "title": "Session",
        "component": "SessionColumn",
        "when": {
          "session": [
            "coding",
            "agent"
          ]
        }
      },
      {
        "spot": "bot.side",
        "id": "bot-column",
        "component": "BotColumn"
      }
    ]
  }
}

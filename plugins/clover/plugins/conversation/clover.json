{
  "manifest": 1,
  "name": "Conversation",
  "description": "The conversation view: a bot's one continuous conversation, with every message kind, streaming and thinking titles.",
  "engines": {
    "clover": "^1.0.0"
  },
  "client": {
    "entry": "client/index.tsx",
    "css": [
      "client/styles.css"
    ]
  },
  "capabilities": [
    "conversation.read",
    "conversation.post",
    "approvals",
    "bots.read",
    "devices.read"
  ],
  "contributes": {
    "ui": [
      {
        "spot": "conversation",
        "component": "ConversationEntry",
        "declares": {
          "conversation.message": {
            "shape": "keyed",
            "props": {
              "type": "object",
              "properties": {
                "bot": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  }
                },
                "session": {
                  "type": "string"
                },
                "item": {
                  "type": "object"
                },
                "ctx": {
                  "type": "object"
                }
              }
            },
            "keep": [
              "approval"
            ],
            "needs": [
              "conversation.read"
            ],
            "context": [
              "bot"
            ],
            "doc": "One message, keyed by kind; the approval cell can't be hidden."
          },
          "conversation.message.extra": {
            "shape": "list",
            "props": {
              "type": "object",
              "properties": {
                "bot": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  }
                },
                "session": {
                  "type": "string"
                },
                "item": {
                  "type": "object"
                },
                "ctx": {
                  "type": "object"
                }
              }
            },
            "needs": [
              "conversation.read"
            ],
            "context": [
              "bot"
            ],
            "doc": "Add-ons under each message, with a UI of their own. A plugin outside Clover's own tree draws in its own layer, so each one is a frame under every message: for a button, use conversation.message.action."
          },
          "conversation.message.action": {
            "shape": "list",
            "props": {},
            "fields": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "icon": {
                  "type": "string"
                },
                "call": {
                  "type": "string"
                },
                "on": {
                  "type": "string",
                  "enum": [
                    "assistant",
                    "user",
                    "both"
                  ]
                }
              },
              "required": [
                "title",
                "call"
              ]
            },
            "context": [
              "bot"
            ],
            "doc": "A small button the conversation draws itself in a message's row of actions, beside copy and speak: no frame, no component. title is its tooltip, icon a picture in the plugin's folder, on which messages carry it (a finished reply by default). A press runs call, a handler in the plugin's own ui table, with { session, seq } and nothing else; it answers { ok: true }, or { note }, one sentence shown under the message for a moment."
          },
          "tool.result": {
            "shape": "keyed",
            "props": {
              "type": "object",
              "properties": {
                "bot": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  }
                },
                "session": {
                  "type": "string"
                },
                "item": {
                  "type": "object"
                },
                "ctx": {
                  "type": "object"
                }
              }
            },
            "needs": [
              "conversation.read"
            ],
            "context": [
              "bot"
            ],
            "doc": "A tool's result, keyed by tool name."
          }
        }
      }
    ]
  }
}

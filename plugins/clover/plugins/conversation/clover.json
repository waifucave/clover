{
  "manifest": 1,
  "name": "Conversation",
  "description": "The conversation view: a bot's one continuous conversation, with every message kind, streaming and thinking titles.",
  "engines": {
    "clover": "^1.0.0"
  },
  "client": {
    "entry": "client/index.tsx",
    "css": [
      "client/styles.css"
    ]
  },
  "capabilities": [
    "conversation.read",
    "approvals",
    "bots.read",
    "devices.read",
    "files"
  ],
  "contributes": {
    "locales": [
      {
        "lang": "en",
        "file": "locales/en.json"
      }
    ],
    "ui": [
      {
        "spot": "conversation",
        "component": "ConversationEntry",
        "declares": {
          "conversation.message": {
            "shape": "keyed",
            "props": {
              "type": "object",
              "properties": {
                "bot": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  }
                },
                "session": {
                  "type": "string"
                },
                "item": {
                  "type": "object"
                },
                "ctx": {
                  "type": "object"
                }
              }
            },
            "keep": [
              "approval"
            ],
            "needs": [
              "conversation.read"
            ],
            "context": [
              "bot"
            ],
            "doc": "One message, keyed by kind; the approval cell can't be hidden."
          },
          "conversation.message.extra": {
            "shape": "list",
            "props": {
              "type": "object",
              "properties": {
                "bot": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  }
                },
                "session": {
                  "type": "string"
                },
                "item": {
                  "type": "object"
                },
                "ctx": {
                  "type": "object"
                }
              }
            },
            "needs": [
              "conversation.read"
            ],
            "context": [
              "bot"
            ],
            "doc": "Add-ons under each message."
          },
          "tool.result": {
            "shape": "keyed",
            "props": {
              "type": "object",
              "properties": {
                "bot": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  }
                },
                "session": {
                  "type": "string"
                },
                "item": {
                  "type": "object"
                },
                "ctx": {
                  "type": "object"
                }
              }
            },
            "needs": [
              "conversation.read"
            ],
            "context": [
              "bot"
            ],
            "doc": "A tool's result, keyed by tool name."
          },
          "file.preview": {
            "shape": "keyed",
            "props": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "mediaType": {
                  "type": "string"
                }
              }
            },
            "doc": "A file's preview, keyed by its media type (`image/png`, or a pattern such as `model/*`): a plugin's, in its own sealed part, handed the path only once the tree's no-follow check says it is a plain file."
          },
          "menu.message": {
            "shape": "list",
            "props": {
              "type": "object",
              "properties": {
                "bot": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  }
                },
                "session": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                }
              }
            },
            "context": [
              "bot"
            ],
            "doc": "Items in a message's menu: each entry's `title`, and the `command` it runs. The command is given the message's id and role; its text only when the plugin declares `conversation.read`."
          }
        }
      }
    ]
  }
}

{
  "manifest": 1,
  "name": "Diff",
  "description": "A code session's changes panel: base against working tree, per file, unified or split. Never in a bot's tab.",
  "engines": {
    "clover": "^1.0.0"
  },
  "client": {
    "entry": "client/index.tsx",
    "css": [
      "client/styles.css"
    ]
  },
  "capabilities": [],
  "contributes": {
    "ui": [
      {
        "spot": "panel",
        "id": "diff",
        "key": "diff",
        "title": "Changes",
        "component": "DiffEntry",
        "when": {
          "session": "coding"
        }
      }
    ]
  }
}

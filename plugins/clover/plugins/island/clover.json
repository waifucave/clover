{
  "manifest": 1,
  "name": "Island",
  "description": "What needs you, at the top of the screen: requests grow from the top centre, and an island with tabs for what waits, your usage and your devices.",
  "engines": { "clover": "^1.0.0" },
  "capabilities": ["approvals", "bots.read"],
  "client": { "entry": "client/index.tsx" },
  "contributes": {
    "locales": [{ "lang": "en", "file": "locales/en.json" }],
    "ui": [
      {
        "spot": "app.surface",
        "id": "island",
        "component": "IslandApp",
        "title": "Island",
        "window": {
          "type": "overlay",
          "alwaysOnTop": true,
          "transparent": true,
          "placement": { "macos": "top-center", "windows": "top-center", "linux": "top-center" }
        },
        "declares": {
          "island.tab": {
            "shape": "list",
            "props": { "type": "object", "properties": { "expanded": { "type": "boolean" } } }
          }
        }
      }
    ]
  }
}

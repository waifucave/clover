{
  "manifest": 1,
  "id": "alpha",
  "name": "Alpha",
  "description": "Clover's first bot: one continuous conversation, with a memory of her own, on every computer you connect.",
  "engines": {
    "clover": "^1.0.0"
  },
  "icon": "assets/portrait.svg",
  "contributes": {
    "bot": {
      "name": "Alpha",
      "instructions": "bot/instructions.md",
      "greeting": "bot/greeting.md",
      "memory": "bot/memory",
      "model": {
        "default": "anthropic/claude-sonnet-5-5",
        "effort": "medium"
      },
      "avatar": {
        "file": "assets/alpha.vrm",
        "format": "vrm",
        "portrait": "assets/portrait.svg"
      },
      "theme": "alpha",
      "layout": "tab/layout.json"
    },
    "themes": [
      {
        "id": "alpha",
        "file": "tab/theme.json"
      },
      {
        "id": "alpha-atelier",
        "file": "tab/theme-b.json"
      }
    ],
    "ui": [
      {
        "spot": "bot.header",
        "id": "header",
        "component": "AlphaHeader"
      },
      {
        "spot": "bot.side",
        "id": "widgets",
        "component": "AlphaWidgets"
      }
    ]
  },
  "client": {
    "entry": "client/index.tsx"
  },
  "capabilities": [
    "bots.read",
    "conversation.read"
  ],
  "settings": {
    "pinned": {
      "type": "string",
      "title": {
        "en": "Pinned note"
      },
      "description": {
        "en": "A line Alpha keeps in view on her stage."
      },
      "default": ""
    }
  }
}

{
  "layout": 1,
  "root": {
    "stack": [
      {
        "spot": "bot.header",
        "prefer": [
          "alpha#header"
        ],
        "class": "alpha-backdrop"
      },
      {
        "column": [
          {
            "row": [
              {
                "spot": "chrome.sidebar",
                "class": "alpha-nav"
              },
              {
                "spot": "chrome.title",
                "class": "alpha-name"
              },
              {
                "spot": "chrome.drag",
                "grow": 1,
                "class": "alpha-drag"
              },
              {
                "spot": "chrome.actions",
                "class": "alpha-actions"
              }
            ],
            "class": "alpha-topline"
          },
          {
            "row": [
              {
                "column": [
                  {
                    "spot": "conversation",
                    "grow": 1,
                    "class": "alpha-conv"
                  },
                  {
                    "spot": "composer",
                    "class": "alpha-composer"
                  }
                ],
                "grow": 1,
                "min": 320,
                "class": "alpha-sheet"
              },
              {
                "size": "44%",
                "min": 260,
                "max": 620,
                "hideBelow": 700,
                "class": "alpha-stage",
                "column": [
                  {
                    "spot": "bot.side",
                    "prefer": [
                      "alpha#widgets"
                    ]
                  },
                  {
                    "spot": "bot.stage",
                    "grow": 1,
                    "class": "alpha-figure"
                  }
                ]
              }
            ],
            "grow": 1,
            "class": "alpha-body"
          }
        ],
        "grow": 1,
        "class": "alpha-page"
      },
      {
        "spot": "chrome.panels",
        "class": "alpha-panels"
      }
    ],
    "grow": 1,
    "class": "alpha-scene"
  },
  "css": "tab/layout.css"
}

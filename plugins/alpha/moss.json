{
  "manifest": 1,
  "id": "alpha",
  "name": "MOSS's stage",
  "description": "The stage, scenes and helpers of MOSS, the default bot the MOSS app offers. She is engine data, not a plugin; her figure and scenes become a pack for the bundled avatar plugin.",
  "icon": "assets/portrait.svg",
  "version": "1.0.0",
  "scope": "own-bot",
  "engines": {
    "moss": "^1.0.0"
  },
  "host": {
    "entry": "server/index.ts",
    "runtime": "bun",
    "declares": {
      "alpha.scenes": {
        "shape": "list",
        "fields": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
            },
            "title": {
              "type": "string",
              "maxLength": 64
            }
          },
          "required": [
            "id",
            "title"
          ],
          "additionalProperties": false
        },
        "doc": {
          "en": "A scene MOSS can stand in: its id and its title. Her stage tool set_scene takes it, and her tab draws it.",
          "ja": "MOSSが立てるシーン。ステージのツール set_scene で使え、タブが描きます。"
        }
      }
    }
  },
  "settings": {
    "scene": {
      "type": "enum",
      "title": {
        "en": "Starting scene",
        "ja": "最初のシーン"
      },
      "description": {
        "en": "The scene MOSS's stage starts in.",
        "ja": "MOSSのステージが始まるシーン。"
      },
      "options": [
        {
          "value": "meadow",
          "title": {
            "en": "Clover meadow",
            "ja": "クローバーの草原"
          }
        },
        {
          "value": "study",
          "title": {
            "en": "Study corner",
            "ja": "書斎"
          }
        },
        {
          "value": "starry",
          "title": {
            "en": "Starry night",
            "ja": "星空"
          }
        },
        {
          "value": "rain",
          "title": {
            "en": "Rainy window",
            "ja": "雨の窓辺"
          }
        }
      ],
      "default": "meadow",
      "scope": "device"
    },
    "outfit": {
      "type": "enum",
      "title": {
        "en": "Outfit",
        "ja": "衣装"
      },
      "description": {
        "en": "What she wears on her stage. It applies to her own model: with another avatar picked for her, that model shows its own outfit parts.",
        "ja": "ステージで彼女が着る服。彼女自身のモデルに適用されます。別のアバターを選んでいるときは、そのモデル自身の衣装パーツが表示されます。"
      },
      "options": [
        {
          "value": "lilac-dress",
          "title": {
            "en": "Lilac dress",
            "ja": "ライラックのドレス"
          }
        },
        {
          "value": "navy-uniform",
          "title": {
            "en": "Navy uniform",
            "ja": "紺の制服"
          }
        },
        {
          "value": "yellow-raincoat",
          "title": {
            "en": "Yellow raincoat",
            "ja": "黄色のレインコート"
          }
        }
      ],
      "default": "lilac-dress"
    },
    "effects": {
      "type": "enum",
      "title": {
        "en": "Stage effects",
        "ja": "ステージの演出"
      },
      "description": {
        "en": "How much her stage animates: confetti, light, motion.",
        "ja": "ステージがどれだけ動くか。紙吹雪、光、動き。"
      },
      "options": [
        {
          "value": "off",
          "title": {
            "en": "Off",
            "ja": "オフ"
          }
        },
        {
          "value": "subtle",
          "title": {
            "en": "Subtle",
            "ja": "控えめ"
          }
        },
        {
          "value": "full",
          "title": {
            "en": "Full",
            "ja": "フル"
          }
        }
      ],
      "default": "full",
      "scope": "device"
    },
    "reactions": {
      "type": "boolean",
      "title": {
        "en": "Stage reactions",
        "ja": "ステージの反応"
      },
      "description": {
        "en": "Her stage reacts to her turns and tools on its own. Off, only today's tally moves.",
        "ja": "ターンやツールに合わせてステージが反応します。オフでは今日の集計だけが動きます。"
      },
      "default": true
    },
    "voice": {
      "type": "boolean",
      "title": {
        "en": "Speak her replies",
        "ja": "返事を声で読む"
      },
      "description": {
        "en": "Her tab speaks her replies in her voice, when a voice is set up.",
        "ja": "声が設定されていれば、タブが返事を読み上げます。"
      },
      "default": false,
      "scope": "device"
    },
    "nickname": {
      "type": "string",
      "title": {
        "en": "What she calls you",
        "ja": "あなたの呼び名"
      },
      "description": {
        "en": "The name MOSS uses for you. Empty: your name, once she knows it.",
        "ja": "MOSSがあなたを呼ぶ名前。空なら、知っていればあなたの名前。"
      },
      "default": "",
      "scope": "bot"
    },
    "pinned": {
      "type": "string",
      "title": {
        "en": "Pinned note"
      },
      "description": {
        "en": "A line MOSS keeps in view on her stage."
      },
      "default": ""
    }
  },
  "contributes": {
    "mcpServers": {
      "stage": {
        "type": "host",
        "tools": {
          "*": "preload"
        },
        "instructions": "server/instructions.md",
        "contained": [
          "set_scene",
          "set_mood",
          "pin_note",
          "unpin_note",
          "celebrate"
        ],
        "readOnly": [
          "stage_status"
        ],
        "scope": "own-bot"
      }
    },
    "hooks": [
      {
        "id": "stage-turn-start",
        "on": [
          "turn.start"
        ],
        "handler": "onTurnStart",
        "scope": "own-bot",
        "timeoutMs": 2000
      },
      {
        "id": "stage-tool-after",
        "on": [
          "tool.after"
        ],
        "handler": "onToolAfter",
        "scope": "own-bot",
        "timeoutMs": 2000
      },
      {
        "id": "stage-turn-end",
        "on": [
          "turn.end"
        ],
        "handler": "onTurnEnd",
        "scope": "own-bot",
        "timeoutMs": 2000
      }
    ],
    "island.line": [
      {
        "id": "activity",
        "handler": "islandLine"
      }
    ],
    "skills": [
      "skills/*/SKILL.md"
    ],
    "agents": [
      {
        "id": "study-buddy",
        "name": {
          "en": "Study buddy",
          "ja": "勉強仲間"
        },
        "backend": "moss-code",
        "instructions": "agents/study-buddy.md"
      }
    ],
    "commands": [
      {
        "name": "scene",
        "description": {
          "en": "Change the scene behind MOSS.",
          "ja": "MOSSの背景のシーンを変えます。"
        },
        "args": {
          "type": "object",
          "properties": {
            "scene": {
              "type": "string",
              "maxLength": 32
            }
          },
          "required": [
            "scene"
          ],
          "additionalProperties": false
        },
        "handler": "scene",
        "scope": "own-bot"
      },
      {
        "name": "mood",
        "description": {
          "en": "Set the mood of MOSS's stage.",
          "ja": "MOSSのステージの雰囲気を変えます。"
        },
        "args": {
          "type": "object",
          "properties": {
            "mood": {
              "type": "string",
              "enum": [
                "calm",
                "focused",
                "alert",
                "joy",
                "sad"
              ]
            }
          },
          "required": [
            "mood"
          ],
          "additionalProperties": false
        },
        "handler": "mood",
        "scope": "own-bot"
      },
      {
        "name": "outfit",
        "description": {
          "en": "Change MOSS's outfit (lilac-dress, navy-uniform, yellow-raincoat); on another avatar picked for her, turn one of its parts on or off.",
          "ja": "MOSSの衣装を替えます（lilac-dress、navy-uniform、yellow-raincoat）。別のアバターでは、そのパーツをオン・オフします。"
        },
        "args": {
          "type": "object",
          "properties": {
            "part": {
              "type": "string",
              "maxLength": 64
            },
            "on": {
              "type": "boolean"
            }
          },
          "required": [
            "part"
          ],
          "additionalProperties": false
        },
        "handler": "outfit",
        "scope": "own-bot"
      }
    ],
    "locales": [
      {
        "lang": "en",
        "file": "locales/en.json"
      },
      {
        "lang": "ja",
        "file": "locales/ja.json"
      }
    ]
  },
  "client": {
    "entry": "client/index.tsx"
  },
  "capabilities": [
    "bots.read",
    "conversation.read",
    "shell.control",
    "shell.read"
  ]
}

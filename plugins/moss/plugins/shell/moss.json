{
  "manifest": 1,
  "name": "Shell",
  "description": "The default shell: the window frame with a translucent title bar, the panel host and its toggles, a session's live tab and the page that starts one. It places every spot it declares: the sidebar, main keyed by route, the panels, the column beside the conversation, the status bar and a dialog layer for Settings.",
  "engines": {
    "moss": "^1.0.0"
  },
  "client": {
    "entry": "client/index.tsx",
    "css": [
      "client/styles.css"
    ]
  },
  "capabilities": [
    "approvals",
    "approvals.all",
    "computers.read",
    "sessions.read",
    "account.read",
    "user.send"
  ],
  "contributes": {
    "ui": [
      {
        "spot": "app.root",
        "component": "Shell",
        "declares": {
          "sidebar": {
            "shape": "single",
            "props": {
              "type": "object",
              "properties": {
                "route": {
                  "type": "object",
                  "properties": {
                    "route": {
                      "type": "string"
                    },
                    "params": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "doc": "The sidebar."
          },
          "main": {
            "shape": "keyed",
            "props": {
              "type": "object",
              "properties": {
                "route": {
                  "type": "string"
                },
                "params": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            },
            "doc": "The main area, keyed by route: agent (a session's live tab), settings, plugins, and the keys app buttons open. The shell draws its own page to start a session (new)."
          },
          "panel": {
            "shape": "keyed",
            "props": {
              "type": "object",
              "properties": {
                "app": {
                  "type": "string"
                },
                "session": {
                  "type": "string"
                }
              }
            },
            "context": [
              "session"
            ],
            "doc": "The panel host, keyed by panel: session, terminal, diff, files, browser, agent. A key no plugin fills shows the host's placeholder."
          },
          "panel.view": {
            "shape": "keyed",
            "props": {
              "type": "object",
              "properties": {
                "view": {
                  "type": "string"
                },
                "session": {
                  "type": "string"
                }
              }
            },
            "doc": "The panel's contents."
          },
          "status": {
            "shape": "list",
            "props": {},
            "doc": "The status bar under the main column."
          }
        }
      },
      {
        "spot": "main",
        "id": "agent-tab",
        "key": "agent",
        "component": "AgentTab"
      },
      {
        "spot": "panel",
        "id": "agent-panel",
        "key": "agent",
        "title": "Agent",
        "component": "AgentTab",
        "when": {
          "session": "agent"
        }
      }
    ]
  }
}

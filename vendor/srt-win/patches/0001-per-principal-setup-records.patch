+    use windows::core::PWSTR;
+    use windows::Win32::Foundation::ERROR_NO_MORE_ITEMS;
+    use windows::Win32::System::Registry::RegEnumKeyExW;
+    let Some(key) = Key::open(path, false)? else {
+        return Ok(Vec::new());
+    };
+    let mut out = Vec::new();
+    let mut index = 0u32;
+    loop {
+        let mut buf = vec![0u16; 256];
+        let mut len = buf.len() as u32;
+        // RegEnumKeyExW writes at most `len` chars and sets `len` to
+        // the count actually written (no NUL).
+        let r = unsafe {
+            RegEnumKeyExW(
+                key.0,
+                index,
+                Some(PWSTR(buf.as_mut_ptr())),
+                &mut len as *mut u32,
+                None,
+                None,
+                None,
+                None,
+            )
+        };
+        if r == ERROR_NO_MORE_ITEMS {
+            break;
+        }
+        r.ok()?;
+        out.push(String::from_utf16_lossy(&buf[..len as usize]));
+        index += 1;
+    }
+    Ok(out)
+}

+/// Remove one principal's Users subkey and Cred blob. Idempotent:
+/// missing keys are not an error.
+fn clear_principal_record(name: &str) -> Result<()> {
+    let subkey = user_subkey(name)?;
+    crate::reg::delete_subtree(&subkey)?;
+    crate::reg::delete_subtree(&cred_key_for(name)?)?;
+    // Drop the now-empty Users parent (and the Cred key once its Blob
+    // value is gone too) so an uninstall leaves no shell behind.
+    if !other_principals_remain(name)? {

{
  "manifest": 1,
  "id": "acceptance-echo",
  "name": "Acceptance echo",
  "description": "The acceptance run's fixture: one host MCP tool, Echo, that answers with what it was given, and one command, say, that says it back.",
  "version": "0.0.1",
  "engines": {
    "clover": "^1.0.0"
  },
  "host": {
    "entry": "host/index.ts",
    "runtime": "bun"
  },
  "contributes": {
    "mcpServers": {
      "echo": {
        "type": "host",
        "tools": {
          "Echo": "preload"
        }
      }
    },
    "commands": [
      {
        "name": "say",
        "description": "Says the text back, and who asked",
        "handler": "say",
        "args": {
          "type": "object",
          "required": [
            "text"
          ],
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 200
            }
          },
          "additionalProperties": false
        }
      }
    ]
  }
}

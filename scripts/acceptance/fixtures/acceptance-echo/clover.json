{
  "manifest": 1,
  "id": "acceptance-echo",
  "name": "Acceptance echo",
  "description": "The acceptance run's fixture: one host MCP tool, Echo, that answers with what it was given.",
  "version": "0.0.1",
  "engines": {
    "clover": "^1.0.0"
  },
  "host": {
    "entry": "host/index.ts",
    "runtime": "bun"
  },
  "contributes": {
    "mcpServers": {
      "echo": {
        "type": "host",
        "tools": {
          "Echo": "preload"
        }
      }
    }
  }
}

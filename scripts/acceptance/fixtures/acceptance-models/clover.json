{
  "manifest": 1,
  "id": "acceptance-models",
  "name": "Acceptance Models",
  "description": "The acceptance run's third-party model plugin (row 1.91): a provider of its own and a hand-written code adapter in its host code, which reaches its one declared host through the core's keyed fetch with the key the user stored for it.",
  "version": "0.0.1",
  "engines": {
    "clover": "^1.0.0"
  },
  "host": {
    "entry": "host/index.ts"
  },
  "capabilities": ["network:api.acceptance-models.com"],
  "contributes": {
    "models": [
      {
        "provider": "acceptance-models",
        "name": "Acceptance Models",
        "catalog": "catalog.json",
        "auth": [
          {
            "method": "api-key",
            "secret": "api-key",
            "help": "The acceptance run's dummy key.",
            "placement": { "header": "x-api-key" }
          }
        ],
        "adapter": "adapter"
      }
    ]
  }
}

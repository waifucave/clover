#!/bin/bash
# heavy: run a heavy job (an Electron or native build, a full test suite, an Xcode build) in one of a few
# shared slots, so parallel agents on one machine don't swamp it (plan §8). While it waits for a free slot it
# prints a line every 30 seconds. Every checkout and the old path, WaifuCave/bin/heavy, share the same slots.
#
#   scripts/heavy <command> [args...]   run the command in a slot; its exit code is heavy's
#   scripts/heavy --status              show who holds the slots and the exclusive lock
#   scripts/heavy --exclusive [--packaged] <command> [args...]
#                                       run the command holding the machine-wide exclusive lock (the coordinator's
#                                       rule: one acceptance or try run at a time): the acceptance (every mode) and
#                                       the try's build and watch scripts take it for their whole run, and queue
#                                       behind each other first-come (a ticket by arrival time; --status lists the
#                                       queue), printing who holds it every 30 seconds. `--packaged` marks
#                                       a packaged run (`run.ts --app`, a try): while one holds the lock, ordinary
#                                       heavy jobs wait before taking a slot, and the packaged run itself starts once
#                                       the jobs already in slots have ended (a busy machine breaks its frame timing),
#                                       not counting a slot whose job is itself queued for the lock (it can't end first).
#                                       The command runs with CLOVER_HEAVY_EXCLUSIVE set to the holder's pid: what it
#                                       starts through heavy (a build, a nested watch or run.ts) runs under the same
#                                       hold, never waiting on it. The lock is a directory made with mkdir, holding the
#                                       holder's pid, what it runs and its kind; a holder that is gone is taken over by
#                                       the next one that looks.
#
# A job runs with the checkout's pinned Bun first on PATH (scripts/pinned-bun; CLOVER_PINNED_BUN=0 turns that off).
# HEAVY_SLOTS (default 8) sets the number of slots, HEAVY_DIR where they live (default: the user cache folder's
# clover-heavy), HEAVY_POLL_SECONDS how often a waiting heavy looks again (default 5). A slot is a directory made
# with mkdir (atomic), holding the pid of the heavy that took it and what it runs; a slot whose heavy is gone is
# freed by the next one that looks.
set -u
slots="${HEAVY_SLOTS:-8}"
poll="${HEAVY_POLL_SECONDS:-5}"
case "$slots" in ''|*[!0-9]*|0) echo "heavy: HEAVY_SLOTS must be a positive number" >&2; exit 2 ;; esac
case "$poll" in ''|*[!0-9]*|0) echo "heavy: HEAVY_POLL_SECONDS must be a positive number" >&2; exit 2 ;; esac
if [ -n "${HEAVY_DIR:-}" ]; then
  dir="$HEAVY_DIR"
elif [ "$(uname -s)" = "Darwin" ]; then
  dir="$HOME/Library/Caches/clover-heavy"
else
  dir="${XDG_CACHE_HOME:-$HOME/.cache}/clover-heavy"
fi
mkdir -p "$dir"

reap() { # free a slot whose owner is gone
  local s="$1" pid
  [ -d "$s" ] || return 0
  pid="$(cat "$s/pid" 2>/dev/null || true)"
  if [ -n "$pid" ]; then
    kill -0 "$pid" 2>/dev/null || rm -rf "$s"
  elif [ -z "$(find "$s" -maxdepth 0 -mmin -1 2>/dev/null)" ]; then
    rm -rf "$s" # no pid after a minute: its owner died while taking it
  fi
}

lock="$dir/exclusive"
# The exclusive lock goes first-come: each waiter takes a ticket named by when it came (microseconds, then its pid)
# and only the first live ticket may take the lock (before, whichever waiter polled first took it).
queue="$dir/exclusive-queue"
now_us() { perl -MTime::HiRes=time -e 'printf "%017d", time * 1000000'; }
reap_queue() { # tickets whose waiter is gone
  local t pid
  for t in "$queue"/*; do
    [ -e "$t" ] || continue
    pid="${t##*-}"
    kill -0 "$pid" 2>/dev/null || rm -f "$t"
  done
}
first_ticket() { reap_queue; ls "$queue" 2>/dev/null | sort | head -1; }
holder() { # the exclusive lock's holder, as "pid kind: what", or nothing when it is free
  reap "$lock"
  [ -d "$lock" ] && printf '%s %s: %s' "$(cat "$lock/pid" 2>/dev/null)" "$(cat "$lock/kind" 2>/dev/null)" "$(cat "$lock/what" 2>/dev/null)"
}
# Whether this process runs under the lock's current holder (CLOVER_HEAVY_EXCLUSIVE names it, and it still holds it).
under_hold() {
  [ -n "${CLOVER_HEAVY_EXCLUSIVE:-}" ] && [ -d "$lock" ] && [ "$(cat "$lock/pid" 2>/dev/null)" = "$CLOVER_HEAVY_EXCLUSIVE" ] && kill -0 "$CLOVER_HEAVY_EXCLUSIVE" 2>/dev/null
}

if [ "${1:-}" = "--status" ]; then
  for i in $(seq 1 "$slots"); do
    s="$dir/slot$i"; reap "$s"
    if [ -d "$s" ]; then
      w="$(cat "$s/waiting-exclusive" 2>/dev/null || true)"
      echo "slot $i: pid $(cat "$s/pid" 2>/dev/null): $(cat "$s/what" 2>/dev/null)$( [ -n "$w" ] && kill -0 "$w" 2>/dev/null && printf ' (waiting for the exclusive lock)')"
    else echo "slot $i: free"; fi
  done
  h="$(holder)"
  if [ -n "$h" ]; then echo "exclusive: pid $h"; else echo "exclusive: free"; fi
  reap_queue
  n=0
  for t in $(ls "$queue" 2>/dev/null | sort); do n=$((n + 1)); echo "queue $n: pid ${t##*-}: $(cat "$queue/$t" 2>/dev/null)"; done
  exit 0
fi
exclusive=false; packaged=false
if [ "${1:-}" = "--exclusive" ]; then
  exclusive=true; shift
  [ "${1:-}" = "--packaged" ] && { packaged=true; shift; }
fi
[ $# -gt 0 ] || { echo "usage: heavy <command> [args...] | heavy --exclusive [--packaged] <command> [args...] | heavy --status" >&2; exit 2; }

# The Bun the checkout you run in pins goes first on PATH, so a heavy job runs on the Bun CI tests whatever other
# Bun the machine has: that checkout's scripts/pinned-bun fetches it on first use. A checkout without one keeps
# PATH as it is, and so does CLOVER_PINNED_BUN=0.
top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ "${CLOVER_PINNED_BUN:-1}" != "0" ] && [ -n "$top" ] && [ -f "$top/.bun-version" ] && [ -x "$top/scripts/pinned-bun" ]; then
  bundir="$("$top/scripts/pinned-bun" --dir)" || { echo "heavy: no pinned Bun (above); CLOVER_PINNED_BUN=0 runs on PATH's bun" >&2; exit 1; }
  PATH="$bundir:$PATH"; export PATH
fi

if $exclusive; then
  # Already under the hold (a try's watch, run.ts inside it): run as part of it; a packaged part marks the hold so.
  if under_hold; then
    $packaged && echo packaged > "$lock/kind"
    exec "$@"
  fi
  waited=0
  mkdir -p "$queue"
  ticket="$(now_us)-$$"
  printf '%s  (in %s)\n' "$*" "$PWD" > "$queue/$ticket"
  # Started from inside an ordinary slot (an acceptance run through plain `heavy`): while it waits for the lock its slot
  # is marked waiting, so a packaged holder waiting for the slots to empty doesn't wait on it (the two waited on each
  # other for good: M's 38 minutes).
  slotmark=""
  if [ -n "${CLOVER_HEAVY_SLOT:-}" ] && [ -d "$CLOVER_HEAVY_SLOT" ]; then slotmark="$CLOVER_HEAVY_SLOT/waiting-exclusive"; echo $$ > "$slotmark"; fi
  trap 'rm -f "$queue/$ticket"; [ -n "$slotmark" ] && rm -f "$slotmark"' EXIT
  trap 'exit 130' INT TERM HUP
  until [ "$(first_ticket)" = "$ticket" ] && mkdir "$lock" 2>/dev/null; do
    h="$(holder)"
    # A holder that was gone has just been cleared (holder reaps it): this ticket, if first, takes the lock at once.
    [ -z "$h" ] && [ "$(first_ticket)" = "$ticket" ] && continue
    ahead=$(( $(ls "$queue" 2>/dev/null | sort | grep -n -x -F "$ticket" | cut -d: -f1) - 1 ))
    [ $((waited % 30)) -lt "$poll" ] && echo "heavy: waiting for the exclusive lock${h:+, held by pid $h}, $ahead ahead in the queue (${waited}s)" >&2
    sleep "$poll"; waited=$((waited + poll))
  done
  rm -f "$queue/$ticket"
  [ -n "$slotmark" ] && rm -f "$slotmark"
  echo $$ > "$lock/pid"; printf '%s  (in %s)\n' "$*" "$PWD" > "$lock/what"
  if $packaged; then echo packaged > "$lock/kind"; else echo run > "$lock/kind"; fi
  trap 'rm -rf "$lock"' EXIT
  trap 'exit 130' INT TERM HUP
  # A packaged run starts on a quiet machine: the jobs already in slots end first (new ones wait for the lock).
  if $packaged; then
    waited=0
    while :; do
      busy=0
      # A slot whose job waits for this lock (marked by its live waiter) isn't busy: it can't go on before this run ends.
      for i in $(seq 1 "$slots"); do
        s="$dir/slot$i"; reap "$s"
        [ -d "$s" ] || continue
        w="$(cat "$s/waiting-exclusive" 2>/dev/null || true)"
        if [ -n "$w" ] && kill -0 "$w" 2>/dev/null; then continue; fi
        busy=$((busy + 1))
      done
      [ "$busy" -eq 0 ] && break
      [ $((waited % 30)) -lt "$poll" ] && echo "heavy: the packaged run waits for $busy heavy job(s) already running to end (${waited}s)" >&2
      sleep "$poll"; waited=$((waited + poll))
    done
  fi
  export CLOVER_HEAVY_EXCLUSIVE=$$
  echo "heavy: exclusive ($(cat "$lock/kind")): $*" >&2
  "$@"
  exit $?
fi

slot=""; waited=0
while [ -z "$slot" ]; do
  # A packaged run holds the machine: wait for it, unless this job is part of it.
  if ! under_hold; then
    h="$(holder)"
    case "$h" in
      *" packaged: "*)
        [ $((waited % 30)) -lt "$poll" ] && echo "heavy: waiting: a packaged run holds the machine, pid $h (${waited}s)" >&2
        sleep "$poll"; waited=$((waited + poll)); continue ;;
    esac
  fi
  for i in $(seq 1 "$slots"); do
    s="$dir/slot$i"; reap "$s"
    if mkdir "$s" 2>/dev/null; then
      echo $$ > "$s/pid"; printf '%s  (in %s)\n' "$*" "$PWD" > "$s/what"
      slot="$s"; break
    fi
  done
  if [ -z "$slot" ]; then
    [ $((waited % 30)) -lt "$poll" ] && echo "heavy: all $slots slots busy, waiting (${waited}s)" >&2
    sleep "$poll"; waited=$((waited + poll))
  fi
done
trap 'rm -rf "$slot"' EXIT
trap 'exit 130' INT TERM HUP
echo "heavy: slot ${slot##*slot}: $*" >&2
# The job knows its slot: an exclusive run it starts marks the slot waiting while it queues (above).
export CLOVER_HEAVY_SLOT="$slot"
"$@"

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // push.waifucave.com: waifucave push (spec §10). Content-free "you have N updates" pushes to the account's
  // phones (APNs) and browsers (Web Push), asked for by the clover/push notifier on the user's computer.
  //
  // The top level is the local profile that the tests use, where every outbound request goes to local fakes of
  // APNs and the Web Push services; env.production is what the first deploy at the live gates would use.
  // Nothing here has been deployed. Secrets are never in this file: APNS_PRIVATE_KEY and VAPID_PRIVATE_KEY come
  // from `wrangler secret put` (production) or the test harness (local).
  "name": "clover-push-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "vars": {
    "ACCOUNT_ISSUER": "https://accounts.waifucave.invalid",
    "ACCOUNT_JWKS": "{\"keys\":[]}",
    "PUSH_AUDIENCE": "push.waifucave.com",
    "APNS_KEY_ID": "LOCALKEY00",
    "APNS_TEAM_ID": "LOCALTEAM0",
    "APNS_TOPIC": "com.waifucave.clover.ios",
    "APNS_PRODUCTION_ORIGIN": "https://api.push.apple.com",
    "APNS_SANDBOX_ORIGIN": "https://api.sandbox.push.apple.com",
    "VAPID_SUBJECT": "mailto:push@waifucave.invalid",
    "VAPID_PUBLIC_KEY": "",
    "WEBPUSH_HOSTS": "fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com,*.notify.windows.com",
    "MAX_TARGETS": "20"
  },
  "durable_objects": {
    "bindings": [{ "name": "PUSH", "class_name": "PushDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PushDO"] }],
  "ratelimits": [
    { "name": "NOTIFY_RATE", "namespace_id": "72001", "simple": { "limit": 60, "period": 60 } },
    { "name": "API_RATE", "namespace_id": "72002", "simple": { "limit": 60, "period": 60 } }
  ],
  "env": {
    "production": {
      "name": "clover-push",
      "workers_dev": false,
      "observability": { "enabled": false },
      "routes": [{ "pattern": "push.waifucave.com", "custom_domain": true }],
      "vars": {
        // Set at the live gates: lane H's account service, the APNs key's ids, the iOS app's bundle id and the
        // VAPID public key (the private halves are secrets).
        "ACCOUNT_ISSUER": "https://waifucave.com/auth",
        "ACCOUNT_JWKS": "{\"keys\":[]}",
        "PUSH_AUDIENCE": "push.waifucave.com",
        "APNS_KEY_ID": "",
        "APNS_TEAM_ID": "",
        "APNS_TOPIC": "",
        "APNS_PRODUCTION_ORIGIN": "https://api.push.apple.com",
        "APNS_SANDBOX_ORIGIN": "https://api.sandbox.push.apple.com",
        "VAPID_SUBJECT": "mailto:push@waifucave.com",
        "VAPID_PUBLIC_KEY": "",
        "WEBPUSH_HOSTS": "fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com,*.notify.windows.com",
        "MAX_TARGETS": "20"
      },
      "durable_objects": {
        "bindings": [{ "name": "PUSH", "class_name": "PushDO" }]
      },
      "ratelimits": [
        { "name": "NOTIFY_RATE", "namespace_id": "72101", "simple": { "limit": 60, "period": 60 } },
        { "name": "API_RATE", "namespace_id": "72102", "simple": { "limit": 60, "period": 60 } }
      ]
    }
  }
}

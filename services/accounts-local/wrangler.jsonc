{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // A local stand-in for waifucave sign-in (lane H's account service), so the services' emulators check real
  // account tokens against a real JWKS URL. It serves:
  //   GET  /.well-known/jwks.json   the signing keys' public halves
  //   POST /dev/token               { account, device, aud, ttl? } -> { token }   (only with DEV_MINT = "1")
  // Its keys are made in memory when it starts, or given by a test harness (SIGNING_JWKS), and never written down.
  // It has no production profile: it is never deployed.
  "name": "clover-accounts-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "vars": {
    "ISSUER": "http://127.0.0.1:8791",
    "DEV_MINT": "1"
  },
  "durable_objects": {
    "bindings": [{ "name": "KEYS", "class_name": "KeysDO" }]
  },
  "migrations": [{ "tag": "v1", "new_classes": ["KeysDO"] }]
}
